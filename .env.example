# Copy to .env and replace the placeholder. Never commit .env.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Set false for models that do not support the temperature parameter.
# Both experimental strategies always use the same sampling and token settings.
OPENAI_USE_TEMPERATURE=true
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=1024

# Relative paths resolve from the project folder, not the current shell folder.
WRITING_LAB_DB_PATH=data/writing_lab.db
